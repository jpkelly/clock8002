# clock8002 Buildroot defconfig (prototype)
# Tested against: Buildroot 2025.02
# Base: raspberrypi5_defconfig
#
# Usage:
#   cp buildroot-external/configs/clock8002_rpi5_defconfig.sample \
#      ~/buildroot/configs/clock8002_rpi5_defconfig
#   cd ~/buildroot
#   make BR2_EXTERNAL=~/clock8002/buildroot-external clock8002_rpi5_defconfig
#   make

# Architecture — Pi 5 is aarch64
BR2_aarch64=y
BR2_cortex_a76=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_6=y
BR2_ARM64_PAGE_SIZE_16K=y

# Raspberry Pi 5 board support
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="$(call github,raspberrypi,linux,576cc10e1ed50a9eacffc7a05c796051d7343ea4)/linux-576cc10e1ed50a9eacffc7a05c796051d7343ea4.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="bcm2712"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2712-rpi-5-b broadcom/bcm2712d0-rpi-5-b"
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="512M"

# Bootloader / firmware
BR2_TARGET_UBOOT=n
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="board/raspberrypi5/config_5.txt"
BR2_PACKAGE_RPI_FIRMWARE_CMDLINE_FILE="board/raspberrypi5/cmdline_5.txt"
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y

# Init
BR2_INIT_SYSTEMD=y

# Basic system
BR2_SYSTEM_DHCP="eth0"
BR2_TARGET_GENERIC_HOSTNAME="piclock"
BR2_TARGET_GENERIC_ROOT_PASSWD="clockwork"
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_OPENSSH_SERVER=y

# External tree hooks
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_CLOCK8002_PATH)/board/clock8002-rpi5/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_CLOCK8002_PATH)/board/clock8002-rpi5/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_CLOCK8002_PATH)/board/clock8002-rpi5/post-image.sh"

# Audio
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_LIB=y

# LTC timecode library (custom package in br2-external)
BR2_PACKAGE_LIBLTC=y

# Hardware utils
BR2_PACKAGE_I2C_TOOLS=y

# Python (OLED daemon)
BR2_PACKAGE_PYTHON3=y
# Draft OLED package set is provided in this br2-external tree.
# Enable these to include OLED daemon dependencies in the image:
# BR2_PACKAGE_PYTHON_SMBUS2=y
# BR2_PACKAGE_PYTHON_LUMA_CORE=y
# BR2_PACKAGE_PYTHON_LUMA_OLED=y

# SDL2 stack
BR2_PACKAGE_SDL2=y
BR2_PACKAGE_SDL2_GFX=y
BR2_PACKAGE_SDL2_IMAGE=y
BR2_PACKAGE_SDL2_MIXER=y
BR2_PACKAGE_SDL2_TTF=y

# clock8002 application
BR2_PACKAGE_CLOCK8002=y
BR2_PACKAGE_CLOCK8002_SOURCE_DIR="/home/pi/clock8002/v4"
