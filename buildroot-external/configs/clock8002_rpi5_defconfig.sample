# clock8002 Buildroot defconfig (prototype)
# Tested against: Buildroot 2025.11
# Kernel matched to the 3rd-party reference unit (b1b490ba, v6.12.41)
# Base: raspberrypi5_defconfig
#
# Usage:
#   cp buildroot-external/configs/clock8002_rpi5_defconfig.sample \
#      ~/buildroot/configs/clock8002_rpi5_defconfig
#   cd ~/buildroot
#   make BR2_EXTERNAL=~/clock8002/buildroot-external clock8002_rpi5_defconfig
#   make

# Architecture — Pi 5 is aarch64
BR2_aarch64=y
BR2_cortex_a76=y
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_12=y
BR2_ARM64_PAGE_SIZE_4K=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y

# Host tools required by post-image.sh regardless of kernel build setting
BR2_PACKAGE_HOST_DTC=y

# Raspberry Pi 5 board support
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="$(call github,raspberrypi,linux,b1b490bae0bb8ad62d1f028ed0dcbbe7395a964d)/linux-b1b490bae0bb8ad62d1f028ed0dcbbe7395a964d.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="bcm2712"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_CLOCK8002_PATH)/board/clock8002-rpi5/linux.config"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2712-rpi-5-b broadcom/bcm2712d0-rpi-5-b broadcom/bcm2712-d-rpi-5-b"
# BR2_TARGET_ROOTFS_EXT2 is not set
# BR2_TARGET_ROOTFS_SQUASHFS is not set
BR2_TARGET_ROOTFS_INITRAMFS=y
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set (rootfs is embedded in the kernel initramfs)

# Bootloader / firmware
BR2_TARGET_UBOOT=n
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_CONFIG_FILE="$(BR2_EXTERNAL_CLOCK8002_PATH)/board/clock8002-rpi5/config.txt"
BR2_PACKAGE_RPI_FIRMWARE_CMDLINE_FILE="$(BR2_EXTERNAL_CLOCK8002_PATH)/board/clock8002-rpi5/cmdline.txt"
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_GENIMAGE=y
BR2_PACKAGE_HOST_MTOOLS=y
BR2_PACKAGE_HOST_KMOD_XZ=y

# Init
BR2_INIT_BUSYBOX=y
BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_CLOCK8002_PATH)/board/clock8002-rpi5/busybox-kmod-disable.config"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y
# Basic system
BR2_SYSTEM_DHCP=""
BR2_TARGET_GENERIC_HOSTNAME="piclock"
BR2_TARGET_GENERIC_ROOT_PASSWD="$$6$$ApaJqHbsWy9XnOH3$$TlT26M/zSpeNDPsQTqgMCFiLwcRzjd6hrHFT7nWQNyzfzGJiAaaht5eWHUZkrcqemgm/n9VCSImoLHuP.HqND."
BR2_PACKAGE_OPENSSH=y
BR2_PACKAGE_OPENSSH_SERVER=y
BR2_PACKAGE_NANO=y

# External tree hooks
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_CLOCK8002_PATH)/board/clock8002-rpi5/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_CLOCK8002_PATH)/board/clock8002-rpi5/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_CLOCK8002_PATH)/board/clock8002-rpi5/post-image.sh"

# Audio
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_ALSACTL=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_UCM_CONF=y

# XZ — needed by target kmod to read .ko.xz compressed modules
BR2_PACKAGE_XZ=y

# LTC timecode library (custom package in br2-external)
BR2_PACKAGE_LIBLTC=y

# Hardware utils
BR2_PACKAGE_I2C_TOOLS=y

# Python + OLED daemon dependencies
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON_SMBUS2=y
BR2_PACKAGE_PYTHON_LUMA_CORE=y
BR2_PACKAGE_PYTHON_LUMA_OLED=y

# GPU — mesa3d V3D Gallium driver (Pi 5)
# V3D auto-selects VC4, OpenGL EGL, GBM, and libdrm
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_V3D=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y

# SDL3 stack (KMS/DRM backend for headless display)
BR2_PACKAGE_SDL3=y
BR2_PACKAGE_SDL3_IMAGE=y
BR2_PACKAGE_SDL3_TTF=y

# Boot splash disabled
# BR2_PACKAGE_FBV is not set
# BR2_PACKAGE_FBV_PNG is not set

# Networking
BR2_PACKAGE_AVAHI=y
BR2_PACKAGE_AVAHI_DAEMON=y
BR2_PACKAGE_DNSMASQ=y
BR2_PACKAGE_HOSTAPD=y
BR2_PACKAGE_IW=y
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_AP_SUPPORT=y
BR2_PACKAGE_WPA_SUPPLICANT_CTRL_IFACE=y
BR2_PACKAGE_WIRELESS_REGDB=y

# WiFi firmware (Pi 5 onboard Broadcom BCM43455)
BR2_PACKAGE_LINUX_FIRMWARE=y
BR2_PACKAGE_LINUX_FIRMWARE_BRCM_BCM43XXX=y

# clock8002 application
BR2_PACKAGE_CLOCK8002=y
BR2_PACKAGE_CLOCK8002_SOURCE_DIR="/home/pi/clock8002-root-ram/v4"

# Raspberry Pi EEPROM bootloader tools
BR2_PACKAGE_RPI_EEPROM=y
