# Sample baseline for clock8002 Buildroot image (prototype only)
# Copy to Buildroot as configs/clock8002_rpi5_defconfig and adjust for your BR version.

BR2_aarch64=y
BR2_INIT_SYSTEMD=y
BR2_SYSTEM_DHCP="eth0"
BR2_TARGET_GENERIC_HOSTNAME="piclock"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_CLOCK8002_PATH)/board/clock8002-rpi5/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_CLOCK8002_PATH)/board/clock8002-rpi5/post-build.sh"
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_I2C_TOOLS=y
BR2_PACKAGE_PYTHON3=y
BR2_PACKAGE_PYTHON_LUMA_OLED=y
BR2_PACKAGE_SDL2=y
BR2_PACKAGE_SDL2_GFX=y
BR2_PACKAGE_SDL2_IMAGE=y
BR2_PACKAGE_SDL2_MIXER=y
BR2_PACKAGE_SDL2_TTF=y
BR2_PACKAGE_CLOCK8002=y
