#!/bin/sh
PIDFILE=/var/run/bootsplash.pid
PICLOCK_INI=/boot/piclock/piclock.ini

_splash_enabled() {
	[ -f "${PICLOCK_INI}" ] || return 1
	val=$(awk -F= '/^splash_enabled/ { gsub(/[[:space:]]/, "", $2); print $2 }' "${PICLOCK_INI}")
	[ "${val}" = "true" ]
}

case "$1" in
	start)
		if ! _splash_enabled; then
			exit 0
		fi
		if [ -f /opt/clock8002/bootsplash.png ] && [ -x /opt/clock8002/bootsplash.sh ]; then
			echo "Starting boot splash"
			/opt/clock8002/bootsplash.sh &
			echo $! > "$PIDFILE"
		fi
		;;
	stop)
		echo "Stopping boot splash"
		if [ -f "$PIDFILE" ]; then
			kill "$(cat $PIDFILE)" 2>/dev/null || true
			rm -f "$PIDFILE"
		fi
		kill $(pidof fbv) 2>/dev/null || true
		;;
	restart|reload)
		"$0" stop; "$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"; exit 1
		;;
esac
exit 0
