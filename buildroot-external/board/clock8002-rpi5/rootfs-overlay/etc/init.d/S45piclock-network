#!/bin/sh

wait_for_nm() {
	local retries=30
	while [ "$retries" -gt 0 ]; do
		nmcli general status >/dev/null 2>&1 && return 0
		retries=$((retries - 1))
		sleep 1
	done
	echo "NetworkManager did not start in time" >&2
	return 1
}

case "$1" in
	start)
		echo "Configuring piclock network"
		(wait_for_nm && /opt/clock8002/piclock-network.sh) &
		;;
	stop)
		true
		;;
	restart|reload)
		"$0" stop
		"$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac

exit 0
