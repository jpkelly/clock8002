#!/bin/sh

INTERFACES_FILE="/boot/interfaces"
HOSTNAME_FILE="/boot/hostname"
CLOCK_FILE="/boot/sdl-clock"
CLOCK_CMD="/boot/clock_cmd.sh"
CLOCK_POKEMON="/boot/clock_pokemon.sh"
NTP_CONF="/boot/ntp.conf"

start() {
	echo "Setting up clock configuration"
	mkdir -p /boot
	# Mount early so we can read splash_enabled and control the framebuffer
	# console before init text accumulates on the display.
	if [ -e /dev/mmcblk0p1 ]; then
		mount -r /dev/mmcblk0p1 /boot 2>/dev/null || true
	else
		mount -r /dev/mmcblk0 /boot 2>/dev/null || true
	fi
	# Control framebuffer console immediately based on splash_enabled.
	# splash=true:  unbind vtcon1 from fb0 and paint splash — no text on display.
	# splash=false: ensure vtcon1 is bound — all console text visible on display.
	_splash=$(awk -F= '/^splash_enabled/ { gsub(/[[:space:]]/, "", $2); print $2 }' /boot/piclock/piclock.ini 2>/dev/null)
	if [ "$_splash" = "true" ]; then
		echo 0 > /sys/class/vtconsole/vtcon1/bind 2>/dev/null || true
		[ -f /boot/piclock/bootsplash.raw ] && dd if=/boot/piclock/bootsplash.raw of=/dev/fb0 bs=4096 2>/dev/null || true
	else
		echo 1 > /sys/class/vtconsole/vtcon1/bind 2>/dev/null || true
	fi
	sleep 5
	if [ -e "$INTERFACES_FILE" ]; then
		echo "Copying network settings"
		cp "$INTERFACES_FILE" /etc/network/interfaces
	fi
	if [ -e "$HOSTNAME_FILE" ]; then
		echo "Setting hostname"
		hostname "$(cat "$HOSTNAME_FILE")"
		cp "$HOSTNAME_FILE" /etc/hostname
	fi
	if [ -e "$CLOCK_FILE" ]; then
		echo "Copying clock binary"
		mkdir -p /root
		cp "$CLOCK_FILE" /root/sdl-clock
		chmod a+x /root/sdl-clock
	fi
	if [ -e "$CLOCK_CMD" ]; then
		echo "Copying clock configuration"
		mkdir -p /root
		cp "$CLOCK_CMD" /root/clock_cmd.sh
		chmod a+x /root/clock_cmd.sh
	fi
	if [ -e "$CLOCK_POKEMON" ]; then
		echo "Copying clock pokemon configuration"
		mkdir -p /root
		cp "$CLOCK_POKEMON" /root/clock_pokemon.sh
		chmod a+x /root/clock_pokemon.sh
	fi
	if [ -e "$NTP_CONF" ]; then
		echo "Copying ntp configuration"
		cp "$NTP_CONF" /etc/ntp.conf
	fi
	if [ -e "/boot/piclock/authorized_keys" ]; then
		echo "Installing SSH authorized_keys from boot"
		mkdir -p /root/.ssh
		chmod 700 /root/.ssh
		cp /boot/piclock/authorized_keys /root/.ssh/authorized_keys
		chmod 600 /root/.ssh/authorized_keys
	fi
}

stop() {
	true
}

case "$1" in
	start)
		start
		;;
	stop)
		stop
		;;
	restart|reload)
		stop
		start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac

exit 0
