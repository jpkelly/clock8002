#!/bin/sh
# Mount the boot FAT partition and copy sdl-clock binaries/scripts from /boot
# so they can be updated by placing files on the SD card boot partition.

SERVICE="sdl-clock"
BIN_FILE="sdl3-clock"
POKEMON_FILE="clock_pokemon.sh"
CMD_FILE="clock_cmd.sh"

start() {
	echo "Setting up $SERVICE configuration"
	mkdir -p /boot
	if [ -e /dev/mmcblk0p1 ]; then
		mount -r /dev/mmcblk0p1 /boot 2>/dev/null || true
	fi
	if [ -e "/boot/$BIN_FILE" ]; then
		echo "Copying $SERVICE binary from boot"
		mkdir -p /root
		cp /boot/$BIN_FILE /root/
		chmod a+x /root/$BIN_FILE
	fi
	if [ -e "/boot/$CMD_FILE" ]; then
		echo "Copying $SERVICE configuration from boot"
		mkdir -p /root
		cp /boot/$CMD_FILE /root/
		chmod a+x /root/$CMD_FILE
	fi
	if [ -e "/boot/$POKEMON_FILE" ]; then
		echo "Copying $SERVICE pokemon configuration from boot"
		mkdir -p /root
		cp /boot/$POKEMON_FILE /root/
		chmod a+x /root/$POKEMON_FILE
	fi
	if [ -e "/boot/piclock/authorized_keys" ]; then
		echo "Installing SSH authorized_keys from boot"
		mkdir -p /root/.ssh
		chmod 700 /root/.ssh
		cp /boot/piclock/authorized_keys /root/.ssh/authorized_keys
		chmod 600 /root/.ssh/authorized_keys
	fi
}

stop() {
	true
}

case "$1" in
	start)
		start
		;;
	stop|restart|reload)
		stop
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac

exit 0
