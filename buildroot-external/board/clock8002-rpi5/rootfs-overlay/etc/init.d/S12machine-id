#!/bin/sh
# Ensure a stable machine-id is available on squashfs+tmpfs builds.
# /var/lib is tmpfs, so regenerate/restore machine-id each boot.
# Persist canonical ID on FAT: /boot/piclock/machine-id.

STORE="/boot/piclock/machine-id"
RUNTIME_DIR="/var/lib/dbus"
RUNTIME_ID="${RUNTIME_DIR}/machine-id"

generate_machine_id() {
	if command -v dbus-uuidgen >/dev/null 2>&1; then
		dbus-uuidgen
		return
	fi

	if command -v uuidgen >/dev/null 2>&1; then
		uuidgen | tr -d '-' | tr 'A-Z' 'a-z'
		return
	fi

	cat /proc/sys/kernel/random/uuid | tr -d '-' | tr 'A-Z' 'a-z'
}

start() {
	mkdir -p "${RUNTIME_DIR}"

	if [ -s "${STORE}" ]; then
		cp -f "${STORE}" "${RUNTIME_ID}"
		echo "machine-id: restored from ${STORE}"
	else
		generate_machine_id > "${RUNTIME_ID}"
		echo "machine-id: generated runtime id"
		mkdir -p /boot/piclock 2>/dev/null || true
		cp -f "${RUNTIME_ID}" "${STORE}" 2>/dev/null || true
	fi

	chmod 0444 "${RUNTIME_ID}" 2>/dev/null || true
	chmod 0444 "${STORE}" 2>/dev/null || true
}

case "$1" in
	start)
		start
		;;
	stop|restart|reload)
		true
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac

exit 0