#!/bin/sh
# Generate and apply /etc/network/interfaces from /boot/piclock/network.ini.
# Works with the current ifupdown stack and supports explicit dhcp/static/dual.

NETWORK_INI="/boot/piclock/network.ini"
INTERFACES_FILE="/etc/network/interfaces"

parse_ini() {
	local file="$1" section="$2" key="$3"
	awk -F= -v section="$section" -v key="$key" '
		/^\[/ { current = substr($0, 2, index($0, "]") - 2) }
		current == section && $1 == key { print $2; exit }
	' "$file"
}

write_interfaces() {
	local mode="$1" addr="$2" mask="$3" gw="$4" dns="$5" tmp
	tmp=$(mktemp)
	{
		echo "# Auto-generated by S43piclock-network-prep from /boot/piclock/network.ini"
		echo ""
		echo "auto lo"
		echo "iface lo inet loopback"
		echo ""
		case "$mode" in
			static)
				echo "auto eth0"
				echo "iface eth0 inet static"
				echo "    address ${addr}"
				echo "    netmask ${mask}"
				[ -n "$gw" ] && echo "    gateway ${gw}"
				[ -n "$dns" ] && echo "    dns-nameservers ${dns}"
				;;
			dual)
				echo "auto eth0"
				echo "iface eth0 inet dhcp"
				echo ""
				echo "iface eth0:1 inet static"
				echo "    address ${addr}"
				echo "    netmask ${mask}"
				[ -n "$gw" ] && echo "    gateway ${gw}"
				[ -n "$dns" ] && echo "    dns-nameservers ${dns}"
				;;
			*)
				echo "auto eth0"
				echo "iface eth0 inet dhcp"
				;;
		esac
	} > "$tmp"
	mv -f "$tmp" "$INTERFACES_FILE"
	chmod 644 "$INTERFACES_FILE"
}

apply_interfaces() {
	local mode="$1"
	# S40 may have already brought interfaces up; re-apply to enforce ini settings.
	if command -v ifdown >/dev/null 2>&1; then
		ifdown eth0:1 2>/dev/null || true
		ifdown eth0 2>/dev/null || true
	fi
	if command -v ifup >/dev/null 2>&1; then
		ifup eth0 2>/dev/null || true
		if [ "$mode" = "dual" ]; then
			ifup eth0:1 2>/dev/null || true
		fi
	fi
}

case "$1" in
	start)
		if [ ! -f "$NETWORK_INI" ]; then
			exit 0
		fi

		NET_HOSTNAME=$(parse_ini "$NETWORK_INI" host hostname)
		if [ -n "$NET_HOSTNAME" ]; then
			hostname "$NET_HOSTNAME"
		fi

		NET_MODE=$(parse_ini "$NETWORK_INI" network mode)
		[ -z "$NET_MODE" ] && NET_MODE="dhcp"
		NET_ADDR=$(parse_ini "$NETWORK_INI" network address)
		NET_MASK=$(parse_ini "$NETWORK_INI" network netmask)
		NET_GW=$(parse_ini "$NETWORK_INI" network gateway)
		NET_DNS=$(parse_ini "$NETWORK_INI" network dns)

		if [ "$NET_MODE" = "static" ] || [ "$NET_MODE" = "dual" ]; then
			if [ -z "$NET_ADDR" ] || [ -z "$NET_MASK" ]; then
				echo "piclock-network-prep: mode=$NET_MODE but address/netmask missing; falling back to dhcp"
				NET_MODE="dhcp"
			fi
		fi

		write_interfaces "$NET_MODE" "$NET_ADDR" "$NET_MASK" "$NET_GW" "$NET_DNS"
		apply_interfaces "$NET_MODE"
		;;
	stop|restart|reload)
		true
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac

exit 0
