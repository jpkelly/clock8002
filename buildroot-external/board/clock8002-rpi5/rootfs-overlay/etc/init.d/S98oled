#!/bin/sh

DAEMON=/opt/clock8002/oled/oled_daemon.py
PIDFILE=/var/run/oled_daemon.pid

case "$1" in
	start)
		echo "Starting OLED daemon"
		python3 "$DAEMON" &
		echo $! > "$PIDFILE"
		;;
	stop)
		echo "Stopping OLED daemon"
		kill $(cat "$PIDFILE" 2>/dev/null) 2>/dev/null || true
		rm -f "$PIDFILE"
		;;
	restart|reload)
		"$0" stop
		"$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac

exit 0
