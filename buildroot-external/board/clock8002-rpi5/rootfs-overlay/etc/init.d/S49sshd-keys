#!/bin/sh
# Persist Dropbear SSH host keys across reboots.
# Keys are stored on the FAT /boot partition (/boot/piclock/ssh/).
# On each boot they are copied to /root/ssh (tmpfs).
# On first boot (or when FAT keys are missing) they are generated and saved.
#
# S50dropbear passes -r flags pointing to /root/ssh/ so Dropbear uses
# the consistent, persisted keys rather than auto-generating each boot.
#
# Runs at S49 — after S03 mounts /boot, before S50dropbear.

KEY_STORE="/boot/piclock/ssh"
KEY_DIR="/root/ssh"

start() {
	mkdir -p "$KEY_DIR"
	chmod 700 "$KEY_DIR"

	if [ -f "$KEY_STORE/dropbear_ed25519_hostkey" ]; then
		# Keys already persisted on FAT — restore for this boot.
		cp "$KEY_STORE"/dropbear_*_hostkey "$KEY_DIR/"
		chmod 600 "$KEY_DIR"/dropbear_*_hostkey
		echo "sshd-keys: host keys restored from $KEY_STORE"
	else
		# First boot or FAT keys missing — generate and save.
		echo "sshd-keys: generating Dropbear host keys (first boot)"
		dropbearkey -t rsa     -f "$KEY_DIR/dropbear_rsa_hostkey"
		dropbearkey -t ed25519 -f "$KEY_DIR/dropbear_ed25519_hostkey"
		mkdir -p "$KEY_STORE"
		# /boot is mounted rw by fstab; remount rw explicitly in case S03 mounted ro.
		mount -o remount,rw /boot 2>/dev/null || true
		cp "$KEY_DIR"/dropbear_*_hostkey "$KEY_STORE/"
		chmod 600 "$KEY_STORE"/dropbear_*_hostkey
		echo "sshd-keys: host keys saved to $KEY_STORE"
	fi
}

case "$1" in
	start)
		start
		;;
	stop|restart|reload)
		true
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;

exit 0
