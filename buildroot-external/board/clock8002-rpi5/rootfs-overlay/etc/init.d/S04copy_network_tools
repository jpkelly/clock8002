#!/bin/sh
# Mount the boot FAT partition and install network tool binaries (dnsmasq, iw)
# from /boot into /usr/sbin so they are available at runtime.
# These binaries are deployed via the golden-working-card boot payload.

start() {
	mkdir -p /boot
	if [ -e /dev/mmcblk0p1 ]; then
		mount -r /dev/mmcblk0p1 /boot 2>/dev/null || true
	else
		mount -r /dev/mmcblk0 /boot 2>/dev/null || true
	fi
	for tool in dnsmasq iw; do
		if [ -e "/boot/${tool}" ]; then
			echo "Installing network tool: ${tool}"
			cp "/boot/${tool}" "/usr/sbin/${tool}"
			chmod 755 "/usr/sbin/${tool}"
		fi
	done
}

stop() {
	true
}

case "$1" in
	start)  start ;;
	stop)   stop ;;
	restart|reload) stop; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac

exit 0
