#!/bin/sh
# Set up /root at boot time.
# /root is a tmpfs mount (see /etc/fstab), so files baked into the rootfs
# at /root/ are hidden at runtime. This script copies launcher scripts
# from /opt/clock8002/ to /root/ and recreates the clock.ini config symlink.
case "$1" in
start)
	echo "Setting up /root"
	mkdir -p /root
	chmod 700 /root

	# Seed /root with the binaries used by the legacy boot-copy runtime.
	for binary in sdl-clock sdl3-clock alsa-ltc; do
		if [ -f "/opt/clock8002/${binary}" ]; then
			cp "/opt/clock8002/${binary}" "/root/${binary}"
			chmod +x "/root/${binary}"
		fi
	done

	# Copy launcher scripts from /opt/clock8002/ to /root/
	for script in clock_pokemon.sh clock_cmd.sh \
		alsa-ltc_pokemon.sh alsa-ltc_cmd.sh \
		power-button.sh; do
		if [ -f "/opt/clock8002/${script}" ]; then
			cp "/opt/clock8002/${script}" "/root/${script}"
			chmod +x "/root/${script}"
		fi
	done

	# Copy OLED logo binary from /opt/clock8002/ to /root/.
	# /root is tmpfs (see /etc/fstab), so the squashfs lower-layer copy
	# at /opt/clock8002/piclockLogo.bin is the persistent source.
	if [ -f "/opt/clock8002/piclockLogo.bin" ]; then
		cp "/opt/clock8002/piclockLogo.bin" "/root/piclockLogo.bin"
		chmod 0644 "/root/piclockLogo.bin"
	fi

	# Recreate clock.ini symlink for sdl3-clock XDG config path.
	# /boot must be mounted before this runs (handled by S03copy_clock_files),
	# but the symlink itself can point to a not-yet-mounted path safely.
	mkdir -p /root/.config/clock-8001
	ln -sf /boot/piclock/clock.ini /root/.config/clock-8001/clock.ini
	;;
stop|restart|reload)
	true
	;;
*)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
	;;
esac
exit 0
