# Disable USB autosuspend for the VIA Labs USB hub (2109:3431) and the
# C-Media CM108 USB audio device (0d8c:0014) downstream of it.
# Without this, the VL805 xHCI host controller on Pi 5 attempts to wake a
# suspended hub/device during snd-usb-audio SET_INTERFACE at boot, causing
# the xHCI command ring to stall and the HC to declare itself dead.
SUBSYSTEM=="usb", ATTRS{idVendor}=="2109", ATTRS{idProduct}=="3431", ATTR{power/control}="on"
SUBSYSTEM=="usb", ATTRS{idVendor}=="0d8c", ATTRS{idProduct}=="0014", ATTR{power/control}="on"
