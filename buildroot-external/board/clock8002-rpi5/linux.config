# clock8002 Pi 5 kernel config fragment
# Kernel: rpi-6.12.y @ 359f37f0 (2025-09-15), bcm2712_defconfig, 4K pages
# Override bcm2712_defconfig default of 16K pages to 4K for USB audio compatibility
# (USB isochronous transfers fail with ETIMEDOUT on VL805 with 16K pages)
CONFIG_ARM64_PAGE_SIZE_4K=y
# CONFIG_ARM64_PAGE_SIZE_16K is not set
# CONFIG_ARM64_PAGE_SIZE_64K is not set
CONFIG_SERIAL_8250_BCM7271=n
# NLS codepage needed for mounting the FAT boot partition at /boot.
CONFIG_NLS_ISO8859_1=y
