# clock8002 Pi 5 kernel config fragment
# Kernel: rpi-6.12.y @ b1b490ba (2025-08-14, v6.12.41), bcm2712_defconfig
# Page size (4K) is controlled by BR2_ARM64_PAGE_SIZE_4K in the Buildroot defconfig.
# linux.mk injects CONFIG_ARM64_4K_PAGES automatically from that setting — do not set here.
# Override bcm2712_defconfig's default "-v8-16k" suffix so uname reflects 4K pages.
CONFIG_LOCALVERSION="-v8-4k"
# Expose active kernel config at /proc/config.gz for on-device verification.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_SERIAL_8250_BCM7271=n
# NLS codepage needed for mounting the FAT boot partition at /boot.
CONFIG_NLS_ISO8859_1=y
# I2C userspace device access (required for OLED via luma.oled).
CONFIG_I2C_DEV=m
# RAM-root boot needs initrd gzip unpack support.
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
# Keep SquashFS + overlayfs available as fallback tooling during migration.
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
