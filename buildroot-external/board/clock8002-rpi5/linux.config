# clock8002 Pi 5 kernel config fragment
# Kernel: rpi-6.12.y @ 6.12.47 (359f37f0faef), bcm2712_defconfig, 16K pages
CONFIG_SERIAL_8250_BCM7271=n
# NLS codepage needed for mounting the FAT boot partition at /boot.
CONFIG_NLS_ISO8859_1=y
# Disable module compression so build-time depmod (host kmod) can read
# .ko files and produce correct modules.alias / modules.dep.  With
# compressed modules the host kmod silently produces empty dependency
# files, breaking udev auto-loading of all modules (DRM, USB audio, etc.).
CONFIG_MODULE_COMPRESS_XZ=n
CONFIG_MODULE_COMPRESS_GZIP=n
CONFIG_MODULE_COMPRESS_NONE=y
