# clock8002 Pi 5 kernel config fragment
# Kernel: rpi-6.12.y (5f23da14d91d), bcm2712_defconfig, 4K pages
# Disable BCM7271 brcmuart driver — triggers bcm2712_pull_config_set SError with 16K pages;
# restored for 4K build as belt-and-suspenders; harmless on Pi 5 (no brcmuart hardware used).
CONFIG_SERIAL_8250_BCM7271=n
