config BR2_PACKAGE_LIBLTC
	bool "libltc"
	depends on BR2_USE_MMU
	help
	  libltc is a portable C library for encoding and decoding of
	  Linear (or Longitudinal) Timecode (LTC), compliant with
	  SMPTE 12M and EBU R68.

	  Used by alsa-ltc to read LTC from an audio input.

	  https://github.com/x42/libltc
