config BR2_PACKAGE_PYTHON_LUMA_CORE
	bool "python-luma-core"
	select BR2_PACKAGE_PYTHON_CBOR2
	select BR2_PACKAGE_PYTHON_PILLOW
	select BR2_PACKAGE_PYTHON_SMBUS2
	help
	  A small library to drive a series of display devices with Python
	  code, with support for PIL/Pillow 2D drawing primitives.

	  https://github.com/rm-hull/luma.core
