config BR2_PACKAGE_SDL3
	bool "sdl3"
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_USE_MMU
	select BR2_PACKAGE_LIBDRM
	help
	  SDL3 is a cross-platform development library for low-level
	  access to audio, keyboard, mouse, joystick, and graphics
	  hardware.

	  This build enables the KMSDRM video backend required for
	  headless Raspberry Pi operation (no X11/Wayland).

	  Required at runtime by sdl3-clock via purego dlopen.

	  https://www.libsdl.org/
