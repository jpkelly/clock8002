[Unit]
Description=Ad-hoc 5-cycle 30s reboot test for LTC/USB wedge
After=alsa-ltc.service network-online.target
Wants=alsa-ltc.service

[Service]
Type=oneshot
RemainAfterExit=no
ExecStart=/opt/clock8002/reboot30-cycle.sh
StandardOutput=journal
StandardError=journal
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
