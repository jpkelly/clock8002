# Clock-8002 Network Configuration
#
# Place this file at /boot/piclock/network.ini
# Settings are applied automatically on every boot.
# Edit, save, and reboot for changes to take effect.

[network]
# mode: dhcp or static
mode=dhcp

# Static IP settings (only used when mode=static)
#address=10.0.0.100
#netmask=24
#gateway=10.0.0.1
#dns=1.1.1.1

[host]
# Hostname for the Pi (without .local)
hostname=piClock

[wifi]
ap_enabled=true
ap_ssid=piClock-ap
ap_password=clockwork
ap_channel=6
