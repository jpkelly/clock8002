# Clock-8002 Network Configuration
#
# Place this file at /boot/firmware/piclock/network.ini (Trixie).
# Settings are applied automatically on every boot.
# Edit, save, and reboot for changes to take effect.

[network]
# mode: dhcp, static, or dual
# dual = DHCP on eth0 plus static alias on eth0:1
mode=static

# NTP time synchronization (true or false)
# Disable if using OSC settime to manually control the clock
ntp=false

# Static IP settings (only used when mode=static or dual)
# Note: gateway is only applied in static mode; 
# In dual mode DHCP provides the default route.
address=192.168.8.245
netmask=24
#gateway=192.168.8.1
#dns=1.1.1.1

[host]
hostname=piClock

[wifi]
ap_enabled=false
ap_ssid=piClock-ap
ap_password=clockwork
ap_channel=6
ap_country=US
