[Unit]
Description=Clock 8002 SDL Display
After=multi-user.target

[Service]
Type=simple
User=pi
WorkingDirectory=/opt/clock8002
Environment=SDL_VIDEODRIVER=kmsdrm
Environment=XDG_RUNTIME_DIR=/run/user/%U
ExecStart=/opt/clock8002/sdl-clock --fullscreen
Restart=always
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
