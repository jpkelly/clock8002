[Unit]
Description=ALSA LTC Timecode Decoder
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User=pi
ExecStartPre=/bin/sh -c 'modprobe snd_usb_audio 2>/dev/null || true; until grep -q Device /proc/asound/cards 2>/dev/null; do sleep 1; done; sleep 2'
ExecStart=/opt/clock8002/alsa-ltc - 255.255.255.255 1245
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
