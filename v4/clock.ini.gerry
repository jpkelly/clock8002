# Clock-8002 default configuration
# Copy to ~/.config/clock-8001/clock.ini

Face=quad
config-schema=2

HTTPUser=admin
HTTPPassword=clockwork

hide-hours=false
disable-icons=false
Format12h=false
ToDHideSeconds=false
HighResolution=false
NoARCorrection=false
FullScreen=true
Background=
BackgroundPath=/boot
BackgroundColor=#000000
DynamicBG=false

NumberFont=RobotoMono-VariableFont_wght.ttf
LabelFont=RobotoMono-VariableFont_wght.ttf
IconFont=MaterialIcons-Regular.ttf

AudioEnabled=false
VoiceEnabled=false
VoiceDir=voices/us
TODBeep=false

info-timer=30

udp-time=receive
udp-timer-1=1
udp-timer-2=2

CountdownTarget=2020-12-24 00:00:00
Countup=false

# Time sources

source1.text=SFO
source1.ltc=false
source1.ltc-channel=0
source1.timer=false
source1.timer-target=false
source1.counter=0
source1.tod=true
source1.timezone=America/Los_Angeles
source1.hidden=false
source1.overtime-color=#ff0000

source2.text=TYO
source2.ltc=false
source2.ltc-channel=0
source2.timer=false
source2.timer-target=false
source2.counter=0
source2.tod=true
source2.timezone=Asia/Tokyo
source2.hidden=false
source2.overtime-color=#ff0000

source3.text=JFK
source3.ltc=false
source3.ltc-channel=0
source3.timer=false
source3.timer-target=false
source3.counter=0
source3.tod=true
source3.timezone=America/New_York
source3.hidden=false
source3.overtime-color=#ff0000

source4.text=ORD
source4.ltc=false
source4.ltc-channel=0
source4.timer=false
source4.timer-target=false
source4.counter=0
source4.tod=true
source4.timezone=America/Chicago
source4.hidden=false
source4.overtime-color=#ff0000

# Timers (0-9)

timer0.stop-at-end=false
timer0.mute=false
timer0.end-restart=false
timer0.end-osc=false
timer0.restart-target=0
timer0.osc-ip=
timer0.osc-port=
timer0.osc-command=
timer0.osc-params=
timer0.duration=600
timer0.countup=false
timer0.port=0
timer0.mitti-broadcast=false
timer0.millumin-broadcast=false
timer0.vmix-enabled=false
timer0.vmix-address=
timer0.vmix-port=8088
timer0.vmix-loops=false
timer0.vmix-pgm-only=false
timer0.vmix-show-pvm=false
timer0.vmix-ignore-overlays=
timer0.vmix-media-name=false
timer0.picturall-enabled=false
timer0.picturall-address=
timer0.picturall-port=11000
timer0.picturall-loops=false
timer0.picturall-streams=false
timer0.picturall-media-name=false
timer0.picturall-ignore-layers=
timer0.disguise-enabled=false
