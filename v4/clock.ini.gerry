# Overtime
overtime-count-mode=zero
overtime-visibility=blink

# Timer color signals
auto-signals=false
signal-start=false
signal-color-start=#00ff00
signal-threshold-warning=180
signal-color-warning=#ffff00
signal-threshold-end=60
signal-color-end=#ff0000
signal-hw-type=unicorn-hd
signal-hw-group=1
signal-hw-brightness=128
signal-hw-follow=false
SignalToBG=false

# Mitti and Millumin
mitti=8
millumin=9
millumin-ignore-layer=ignore
picturall-timeout=1000
vmix-interval=200
vmix-timeout=1000

# Tricaster
tricaster-enabled=false
tricaster-address=
tricaster-username=admin
tricaster-password=admin
tricaster-timer=5
tricaster-show-pvm=false
tricaster-event-enabled=false
tricaster-event-timer=5
tricaster-media-name=false
tricaster-media-color=#ff8000
tricaster-media-bg=#101010
tricaster-interval=100
tricaster-timeout=1000

# Limitimer
limitimer-mode=off
limitimer-serial=/dev/ttyAMA3
limitimer-receive-timer1=false
limitimer-receive-timer2=false
limitimer-receive-timer3=false
limitimer-receive-timer4=false
limitimer-receive-timer5=false
limitimer-broadcast-timer1=false
limitimer-broadcast-timer2=false
limitimer-broadcast-timer3=false
limitimer-broadcast-timer4=false
limitimer-broadcast-timer5=false

# Perfect Cue
cue-enabled=false
cue-serial=/dev/ttyAMA1
cue-duration=2
cue-fullscreen=false

# Hyperdeck
hyperdeck-enabled=false
hyperdeck-address=
hyperdeck-relay=false
hyperdeck-timer=8
hyperdeck-media-name=false
hyperdeck-timeout=1000

# Disguise
disguise-timeout=1000

# Font
Font=fonts/7x13.bdf

# Colors

# Round clocks
text-color=#ff8000
static-color=#505000
second-color=#c80000
countdown-color=#ff0000

# Text clock
label-color=#ff8000
label-alpha=255
row1-color=#ff8000
row1-alpha=255
row2-color=#ff8000
row2-alpha=255
row3-color=#ff8000
row3-alpha=255
draw-boxes=false
timer-bg-color=#202020
timer-bg-alpha=255
label-bg-color=#202020
label-bg-alpha=255
numbers-size=250

# Engine
Debug=false
Flash=500
DisableOSC=false
ListenAddr=0.0.0.0:1245
Timeout=1000
DisableFeedback=false
Connect=255.255.255.255:1245
DisableHTTP=false
HTTPPort=:80
DisableLTC=false
LTCSeconds=false
LTCFollow=false

# GPIO
gpio-enabled=false
gpio-seconds-a-pin=5
gpio-seconds-pulse-pin=6
gpio-seconds-trigger=17
gpio-minutes-a-pin=13
gpio-minutes-pulse-pin=19
gpio-minutes-trigger=27
gpio-hours-a-pin=26
gpio-hours-pulse-pin=20
gpio-hours-trigger=22
gpio-pulse-duration=300
gpio-invert-polarity=false

VFD=false
